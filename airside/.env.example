# Copy to airside/.env (gitignored). Never commit a real token.
AEAC_CONNECTION_TOKEN=
# Required only when explicitly enabling the real-aircraft telemetry sender.
AEAC_UAV_ID=
# Never enable during receive-only server capture or SITL.
USE_AEAC_TELEMETRY=false
# Set false for authorized props-off connectivity checks; no autonomous mission.
USE_ENGINE=true
# Confirm the competition server's current WebSocket endpoint before using live mode.
AEAC_WEBSOCKET_URL=
# Required before enabling autonomous live avoidance; -1/empty is not ready.
AEAC_OWN_AIRCRAFT_INDEX=
# Required for live autonomy: approved WGS84 polygon as [[lat,lon],...].
# No boundary means the controller holds. The SITL fixture is not a field boundary.
FLIGHT_BOUNDARY_WGS84=
