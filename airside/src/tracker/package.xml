<?xml version="1.0"?>
<package format="3">
  <name>tracker</name>
  <version>0.1.0</version>
  <description>Bridges the LTE tracker (MQTT) to ROS 2 and records a Task 2 CSV</description>
  <maintainer email="uwarg@uwaterloo.ca">WARG Autonomy Subteam</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>