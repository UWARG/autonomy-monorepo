<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>airside_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the airside system.</description>
  <maintainer email="uwarg@uwaterloo.ca">WARG Autonomy Subteam</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>camera</exec_depend>
  <exec_depend>engine</exec_depend>
  <exec_depend>navigation</exec_depend>
  <exec_depend>comms</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
