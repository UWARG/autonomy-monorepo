<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Visual-only camera scene: no collisions, no vehicle/physics changes. -->
  <model name="warg_dashboard_terrain">
    <static>true</static>
    <pose>0 0 0.003 0 0 0</pose>
    <link name="visual_ground">
      <visual name="grass">
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.8 0.8</size></plane></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse>
          <pbr><metal><albedo_map>model://runway/materials/textures/Grass004_2K_Color.jpg</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr>
        </material>
      </visual>
      <visual name="dirt">
        <pose>0.08 0.03 0.001 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.3 0.16 0.06 1</ambient><diffuse>0.4 0.24 0.1 1</diffuse></material>
      </visual>
      <visual name="pebble_one">
        <pose>0.035 0.025 0.005 0 0 0</pose>
        <geometry><ellipsoid><radii>0.012 0.008 0.005</radii></ellipsoid></geometry>
        <material><ambient>0.3 0.3 0.28 1</ambient><diffuse>0.5 0.5 0.45 1</diffuse></material>
      </visual>
      <visual name="pebble_two">
        <pose>-0.03 -0.02 0.004 0 0 0</pose>
        <geometry><ellipsoid><radii>0.009 0.013 0.004</radii></ellipsoid></geometry>
        <material><ambient>0.25 0.23 0.2 1</ambient><diffuse>0.4 0.38 0.32 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
